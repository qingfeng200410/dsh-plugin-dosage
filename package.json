{
  "name": "dsh-plugin-dosage",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: one sidebar Usage/Balance popover combining multi-provider accounts with peak/off-peak per-call billing.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "usage",
    "cost",
    "tokens",
    "cache",
    "balance"
  ],
  "license": "MIT",
  "author": "qingfeng200410",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingfeng200410/dsh-plugin-dosage.git"
  },
  "contributors": [
    {
      "name": "qingfeng200410",
      "url": "https://github.com/qingfeng200410"
    },
    {
      "name": "liu3734",
      "url": "https://github.com/liu3734"
    }
  ],
  "homepage": "https://github.com/qingfeng200410/dsh-plugin-dosage#readme",
  "bugs": {
    "url": "https://github.com/qingfeng200410/dsh-plugin-dosage/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./usage": "./lib/stats/usage.js",
    "./stats": "./lib/stats/server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "node scripts/check-package.js",
    "prepublishOnly": "node scripts/check-package.js",
    "pack": "npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
